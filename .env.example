# Copy to .env (gitignored; mode 600) and fill in. `make up` reads it; nothing here is a real secret.
# Each device: name=token, comma-separated; tokens of at least 32 random characters. Issuing one is consent.
SAGE_DEVICES=reachy=replace-with-a-32-plus-character-token
# Ollama's base URL (native /api/chat, no /v1). From the container, the host's Ollama is host.docker.internal.
SAGE_MODEL_URL=http://host.docker.internal:11434
# The live-turn model (thinking is turned off per request).
SAGE_MODEL=qwen3:1.7b
# For background work; configured, not used yet.
SAGE_BACKGROUND_MODEL=qwen2.5:7b
# A reply recorded more than this many seconds ago is stale and should not be spoken.
SAGE_FRESH_SECONDS=10
# Experiment, off unless the lead ships it: replace an all-repeated reply with a short acknowledgement.
SAGE_REPEAT_FALLBACK=0
# Proactive speech (docs/PROTOCOL.md §9), in seconds unless noted.
SAGE_GREET_AFTER_ABSENT_S=300
SAGE_GREET_ON_START=1
SAGE_NUDGE_AFTER_IDLE_S=600
SAGE_NUDGE_GAP_S=900
SAGE_NUDGES_PER_HOUR=3
SAGE_ENGAGED_S=60
SAGE_QUIET_S=1800
