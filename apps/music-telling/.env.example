# music-telling runs on a free local model by default - no key required.
# Install it with: make ollama

MUSIC_TELLING_PROVIDER=ollama
MUSIC_TELLING_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# Context window for the local model. Ollama defaults to 4096, which silently
# truncates lyrics; the pipeline asks for 16384.
# MUSIC_TELLING_NUM_CTX=16384

# Optional: switch to Claude instead of the local model.
# MUSIC_TELLING_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# MUSIC_TELLING_CACHE=/tmp/music-telling-cache
