# Settings for Reachy's Sage voice. Copy this file to .env and fill it in:
#   ~/.config/reachy_mini/sage_voice/.env   read when the daemon launches the app
#                                           (macOS: ~/Library/Application Support/reachy_mini/sage_voice/.env)
#   ./.env (here, or any folder above)      read by `make run` too
# Variables already in the environment win over both files, and the first
# file wins over the second. .env is gitignored: never commit a real token.

# Required: addresses and the token have no defaults.
# The kernel's device listener (protocol v1).
SAGE_VOICE_KERNEL_URL=http://127.0.0.1:8776
# This robot's token from the kernel's SAGE_DEVICES.
SAGE_VOICE_KERNEL_TOKEN=
# Parakeet, OpenAI-compatible, with or without /v1.
SAGE_VOICE_STT_URL=http://127.0.0.1:8781
# Pocket TTS, OpenAI-compatible.
SAGE_VOICE_TTS_URL=http://127.0.0.1:8782
# The robot's daemon, for `make run` only (a daemon-launched app needs none).
# REACHY_MINI_HOST=reachy-mini.local

# Optional: the values shown are the defaults.
# SAGE_VOICE_STT_MODEL=parakeet-tdt-0.6b-v2
# SAGE_VOICE_TTS_MODEL=kokoro
# SAGE_VOICE_TTS_VOICE=azelma
# silence: a pause ends your turn. smart: Smart Turn v3 decides.
# SAGE_VOICE_TURN=silence
# Silence (ms) that ends a turn; calibrate with `uv run sage-voice-turn-end turn-*.wav`.
# SAGE_VOICE_TURN_END_MS=450
# smart only: silence (ms) that ends a turn Smart Turn calls incomplete.
# SAGE_VOICE_TURN_TIMEOUT_MS=1500
# mean, 0 or 1 of the mic array's stereo.
# SAGE_VOICE_MIC_CHANNEL=mean
# 1: report seen/lost from the face tracker (needs a kernel that accepts presence events).
# SAGE_VOICE_PRESENCE=0
# 0: no thinking glance before a reply.
# SAGE_VOICE_LISTEN_CUES=1
# 0: no breathing when idle and no glance toward a voice.
# SAGE_VOICE_IDLE=1
# Multiplies every idle amplitude (head, body sway, antennas): 0.5 calmer, 1.5 livelier.
# SAGE_VOICE_IDLE_SCALE=1
# 1: idle motion on the 50 Hz motion arbiter instead (one deploy, then the default).
# SAGE_VOICE_ARBITER=0
# With the arbiter: how fast moves go, 0.25 to 2 (0.5 slower and softer, 2 twice as fast).
# SAGE_VOICE_MOTION_SPEED=1
# A transcript that stops mid-sentence waits this long (ms) for the rest; 0 off, e.g. 2000.
# SAGE_VOICE_HOLD_MS=0
# Speech (ms) that must last before the robot stops talking.
# SAGE_VOICE_BARGE_IN_MS=200
# 0: a quiet mic ends the run at once, without first resetting the robot's media.
# SAGE_VOICE_MIC_RECOVERY=1
# Seconds a dance runs ahead of the music it hears.
# SAGE_VOICE_DANCE_LEAD_S=0.2
# Names to hear and say right, written:spoken:heard|heard,... (names.py).
# SAGE_VOICE_NAMES=
# The song research service; set, it declares listen_to_song.
# SAGE_VOICE_RESEARCH_URL=
# 1: answer only when addressed (a face is tracked, its name is said, or it just spoke).
# SAGE_VOICE_ADDRESSED=0
# Names besides Sage it answers to, comma-separated.
# SAGE_VOICE_ALIASES=Reachy
# Seconds after it spoke during which no name or face is needed.
# SAGE_VOICE_EXCHANGE_S=8
# A local folder: save each utterance as a WAV. Off when unset; never commit it.
# SAGE_VOICE_RECORD_DIR=
# The build this session runs, named in its log (make pet); set by whatever starts it.
# SAGE_VOICE_BUILD=
